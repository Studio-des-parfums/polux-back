PORT=3002

# Base de données dédiée à Polux (teams, projects, tasks, comments, attachments)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=polux

# API interne de sdp-dashboard : seul service connecté à la base globale. Vérifie
# l'identité (header x-user-email) — voir src/services/dashboardUsers.ts.
DASHBOARD_API_URL=http://localhost:3001
INTERNAL_API_KEY=

# AWS S3 — même bucket que sdp-dashboard/server/services/s3.ts, préfixe dédié polux/
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_REGION=eu-west-3

# Resend — même clé que sdp-dashboard/server/.env (RESEND_API_KEY)
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@sdp-paris.com
POLUX_APP_URL=https://main.d1e2pr3r9i0qy0.amplifyapp.com/project/polux
